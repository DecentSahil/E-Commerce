# ============================================================
# cart-service — Shopping Cart
# Port: 8087
# Depends on: service-registry, config-server, PostgreSQL, Kafka, product-service (Feign)
# ============================================================

# --- Server ---
# Port is hardcoded to 8087 in config-repo; override here if needed
SERVER_PORT=8087

# --- PostgreSQL (dedicated cart database) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_cart_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Eureka (Service Registry) ---
EUREKA_URL=http://localhost:8761/eureka/

# --- RabbitMQ (Spring Cloud Bus) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
