# ==========================================
# USER SERVICE ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Server Configuration (Runs on 8082 to avoid colliding with Auth Service on 8081)
SERVER_PORT=8082

# PostgreSQL Database Configuration (User Service Database)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/user_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_user_db_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# JPA / Hibernate
SPRING_JPA_SHOW_SQL=false

# JWT Validation (Must match Auth Service Secret to verify signatures)
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ISSUER=ecommerce-auth-service
