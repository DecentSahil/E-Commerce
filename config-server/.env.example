# ============================================================
# config-server — Spring Cloud Config Server
# Port: 8888
# Depends on: service-registry (Eureka)
# ============================================================

# --- Config Repository (Git) ---
# URI of the Git repo that holds all service config files
CONFIG_REPO_URI=https://github.com/YOUR_USERNAME/ecommerce-config-repo.git
CONFIG_REPO_BRANCH=main

# Leave blank for public repos. For private repos, use a GitHub PAT.
CONFIG_REPO_USERNAME=
CONFIG_REPO_PASSWORD=

# --- Eureka (Service Registry) ---
EUREKA_HOSTNAME=localhost
EUREKA_URL=http://localhost:8761/eureka/

# --- RabbitMQ (Spring Cloud Bus — for /actuator/busrefresh propagation) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
