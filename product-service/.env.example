# ============================================================
# product-service — Product Catalog, Listings, Brands & Categories
# Port: 8083
# Depends on: service-registry, config-server, PostgreSQL, Kafka
# ============================================================

# --- Server ---
SERVER_PORT=8083

# --- PostgreSQL (dedicated product database) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_product_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- Database Connection Pool (HikariCP) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Eureka (Service Registry) ---
EUREKA_URL=http://localhost:8761/eureka/

# --- RabbitMQ (Spring Cloud Bus) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JPA / Hibernate ---
SPRING_JPA_SHOW_SQL=false
