# ==========================================
# AUTH SERVICE ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Server Configuration
SERVER_PORT=8081

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# JPA / Hibernate
SPRING_JPA_SHOW_SQL=false

# JWT Security Configuration
# Generate a cryptographically secure 256-bit or 512-bit hex/base64 string in production!
# e.g., openssl rand -hex 32
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000     # 15 minutes (15 * 60 * 1000)
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000 # 7 days (7 * 24 * 60 * 60 * 1000)
JWT_ISSUER=ecommerce-auth-service
