# ============================================================
# auth-service — Authentication & Authorization
# Port: 8081
# Depends on: service-registry, config-server, PostgreSQL, Redis, Kafka
# ============================================================

# --- Server ---
SERVER_PORT=8081

# --- PostgreSQL (dedicated auth database) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- Database Connection Pool (HikariCP) ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# --- Redis (OTP / token blacklisting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
# !! CHANGE THIS in production — use a 256-bit (64-char hex) secret !!
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
JWT_ISSUER=ecommerce-auth-service

# --- Eureka (Service Registry) ---
EUREKA_URL=http://localhost:8761/eureka/

# --- RabbitMQ (Spring Cloud Bus) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JPA / Hibernate ---
SPRING_JPA_SHOW_SQL=false
